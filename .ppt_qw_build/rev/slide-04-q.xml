        <p>04</p>
      </content>
    </shape>
    <shape type="text" topLeftX="112" topLeftY="386" width="788" height="26">
      <content textType="body" fontSize="15" fontFamily="思源宋体" color="rgba(42,45,48,1)" textAlign="left">
        <p><span bold="true">启发 · 下一步</span></p>
